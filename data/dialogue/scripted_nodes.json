        }
      ]
    },
    {
      "id": "ep13_c",
      "speaker": "yua",
      "line": "湿着。头发到现在还是湿的。\n\n小镇这么大，我湿着走回来，路上碰到三个认识的。",
      "choices": [
        {
          "text": "继续",
          "next": "ep13_end"
